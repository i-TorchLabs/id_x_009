# id_x_009 后端服务镜像（Litestar + Granian，引擎层 i-Core 作为 ASGI 宿主）。
#
# 构建上下文必须是 i-Core 仓库根：
#   podman build -t localhost/id_x_009-service -f x_models/id_x_009/ops/Dockerfile.service .

# --------------------------- 构建阶段 ---------------------------
FROM docker.io/library/python:3.10-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/ \
    PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn \
    PIP_DEFAULT_TIMEOUT=60

RUN sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null \
    || sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null \
    || true

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY x_models/id_x_009/requirements.txt /tmp/requirements.txt
COPY x_models/id_x_009/requirements-llm-adapter.txt /tmp/requirements-llm-adapter.txt
RUN pip install --no-cache-dir --retries 3 \
      -r /tmp/requirements.txt \
      -r /tmp/requirements-llm-adapter.txt

# --------------------------- 运行阶段 ---------------------------
FROM docker.io/library/python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    TZ=Asia/Shanghai \
    HOME=/home/app

WORKDIR /app/i-Core

RUN sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null \
    || sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null \
    || true \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /app/i-Core/logs \
    && chown -R app:app /app/i-Core

COPY --from=builder /opt/venv /opt/venv

COPY --chown=app:app main.py /app/i-Core/main.py
COPY --chown=app:app src /app/i-Core/src
COPY --chown=app:app utils /app/i-Core/utils
COPY --chown=app:app config /app/i-Core/config
COPY --chown=app:app x_models/_contracts /app/i-Core/x_models/_contracts
COPY --chown=app:app x_models/id_x_009 /app/i-Core/x_models/id_x_009

# 容器专用配置：仅加载 id_x_009 插件
COPY --chown=app:app x_models/id_x_009/ops/base_config.container.toml /app/i-Core/config/base_config.toml

USER app

EXPOSE 7000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=10 \
    CMD curl -sf -X POST http://127.0.0.1:7000/b/id_x_009/graphql \
        -H "Content-Type: application/json" \
        -d '{"query":"{ health { status } }"}' || exit 1

CMD ["python", "main.py"]

FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Shanghai

WORKDIR /app/i-Core

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY x_models/id_x_009/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY main.py /app/i-Core/main.py
COPY src /app/i-Core/src
COPY utils /app/i-Core/utils
COPY config /app/i-Core/config
COPY x_models/_contracts /app/i-Core/x_models/_contracts
COPY x_models/id_x_009 /app/i-Core/x_models/id_x_009

COPY x_models/id_x_009/ops/base_config.container.toml /app/i-Core/config/base_config.toml

RUN mkdir -p /app/i-Core/logs

EXPOSE 7000

CMD ["python", "main.py"]

# ====================================================================
# id_x_009 一体化容器部署环境变量（内置 PostgreSQL + pgvector）
#
# 首次运行 up.sh 时会从本文件生成 .env，请按需修改后重新运行。
#
# 数据库：Pod 内启动 docker.io/pgvector/pgvector:pg18；
# service 经 127.0.0.1:5432 访问；表结构由应用 build_tables 幂等创建，
# ops/init/*.sql 在首次建库时由 Postgres 入口脚本执行（种子数据）。
#
# 本文件同时承担两个角色：
#   1. up.sh 读取（db 初始化参数、镜像与端口选择）
#   2. 以 --env-file 注入 service 容器（ID009_* 等）
#
# 本地非容器开发请另用模块根 .env.template → .env（由 env_loader 加载）。
#
# 日志：up.sh / compose 将容器 /app/i-Core/logs 绑定到
#   x_models/id_x_009/logs/（info.log / warn.log / error.log）
# ====================================================================

# ---- PostgreSQL（db 容器 / pgvector:pg18）----
POSTGRES_DB=id_x_009
POSTGRES_USER=postgres
# 必填：请替换为强随机口令（勿使用示例值上线）
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- 镜像与端口 ----
POSTGRES_IMAGE=docker.io/pgvector/pgvector:pg18
HAPROXY_IMAGE=docker.io/library/haproxy:3.0
# 宿主机暴露端口（haproxy 入口）：http://localhost:<POD_PORT>/
POD_PORT=8009
# PostgreSQL 仅绑定本机回环，避免对全网卡暴露
# 直连：psql -h 127.0.0.1 -p <DB_HOST_PORT> -U postgres -d id_x_009
DB_HOST_PORT=55409
DB_BIND_ADDR=127.0.0.1
# 勿设置 DB_HOST=host.containers.internal：up.sh 会强制 DB_HOST=127.0.0.1
#（同 Pod 内置库）。写成 host gateway 会连到 169.254.1.2:5432 并 Connection refused。

# ---- LLM 网关（service 容器；模型清单/Base-Url 见 User_Guide）----
# 真实 API Key 只放运行时 .env / Secret，勿写入 ops/init/*.sql 或提交到 git。
ID009_LLM_BASE_URL=https://apihk.chinarouter.net/v1
ID009_LLM_API_KEY=
# 本地联调 http://127.0.0.1 时设为 1；生产保持关闭
# ID009_LLM_ALLOW_LOCALHOST=0
# 开启后对域名做 DNS 私网检测（企业 DNS 可能误杀，默认关闭）
# ID009_LLM_STRICT_SSRF=0
# 单次上游请求超时（秒）。慢模型 / 长上下文建议 ≥300
ID009_LLM_TIMEOUT_SECONDS=300
# SDK 层自动重试（超时会重复计费，评测默认保持 0；样本级重试见下方）
ID009_LLM_MAX_RETRIES=0
ID009_LLM_TOKEN_PARAMETER=max_tokens
# 默认 0：按数据库 models_info（模型信息表）单价计费
ID009_LLM_INPUT_COST_PER_1K_TOKENS=0
ID009_LLM_OUTPUT_COST_PER_1K_TOKENS=0
# 评测样本级重试：瞬时超时/连接/429/5xx 自动重试；耗尽后默认跳过该样本继续任务
ID009_EVAL_SAMPLE_MAX_RETRIES=2
ID009_EVAL_SAMPLE_RETRY_BACKOFF_SECONDS=2
ID009_EVAL_CONTINUE_ON_SAMPLE_ERROR=true

# ---- 时区（全容器统一 Asia/Hong_Kong）----
TZ=Asia/Hong_Kong

# ---- 评测运行时（默认真实；simulated 已禁用）----
ID009_EVAL_MODE=real
# 任务勾选的 dataset_samples 优先；仅当库内无样本时才回退本格式
# financebench=仅业务专项文件评测 | domain/six_domain=六域文件评测
ID009_EVAL_FORMAT=financebench
# 可选；未填时默认镜像内 data/finqa/finqa_test_100.json
# ID009_EVAL_SAMPLES_FILE=/app/i-Core/x_models/id_x_009/data/finqa/finqa_test_100.json

# ---- 每日全量评测（Asia/Hong_Kong 00:00）----
ID009_DAILY_EVAL_ENABLED=true
ID009_DAILY_EVAL_HOUR=0
ID009_DAILY_EVAL_MINUTE=0
ID009_DAILY_EVAL_TZ=Asia/Hong_Kong
# 可选：逗号分隔，跳过指定模型名
# ID009_DAILY_EVAL_SKIP_MODELS=local-smoke-model

# ---- 运行时开关（可选）----
# DEBUG_MODE=false

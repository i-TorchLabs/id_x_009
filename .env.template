# ====================================================================
# 环境变量加载优先级（高 → 低）：
#   1. 模块 .env  (x_models/id_x_009/.env)  — 本文件，覆盖根 .env 同名变量
#   2. 项目根 .env (i-Core/.env)
#
# 用法：
#   cp x_models/id_x_009/.env.template x_models/id_x_009/.env
#   再按需填写；真实密钥勿提交 Git（.env 已在 .gitignore）。
#
# 说明：高优先级的环境变量会覆盖低优先级的同名环境变量。
# ====================================================================

# --------------------------------------------------------------------
# 数据库配置
# --------------------------------------------------------------------

# 本模块映射的数据库名（明文），主程序 / 脚本按模块独立建连
DB_NAME=id_x_009

# 数据库连接参数（加密存储，用主程序 utils/encrypt_util.py 生成，
# 运行时由引擎层自动解密；本地明文开发可直接填 127.0.0.1 等）
DB_HOST=encrypted_db_host
DB_PORT=encrypted_db_port
DB_USERNAME=encrypted_db_username
DB_PASSWORD=encrypted_db_password

# --------------------------------------------------------------------
# LLM 网关（OpenAI 兼容 Chat Completions，服务端密钥）
# Base-Url / 可用模型 / 单价见库表 models_info；API Key 勿写入 SQL
# --------------------------------------------------------------------

ID009_LLM_BASE_URL=https://apihk.chinarouter.net/v1

# API Key（必填；勿提交 Git；启动时回填空的 models_info.api_key）
ID009_LLM_API_KEY=
# ID009_LLM_ALLOW_LOCALHOST=0
# ID009_LLM_STRICT_SSRF=0

# 单次上游请求超时（秒）。慢模型 / 长上下文建议 ≥300
ID009_LLM_TIMEOUT_SECONDS=300
# SDK 层自动重试（超时会重复计费，评测默认保持 0）
ID009_LLM_MAX_RETRIES=0
ID009_LLM_TOKEN_PARAMETER=max_tokens

# 全局每 1K tokens 覆盖价（默认 0 = 使用价表按模型计费）
ID009_LLM_INPUT_COST_PER_1K_TOKENS=0
ID009_LLM_OUTPUT_COST_PER_1K_TOKENS=0

# --------------------------------------------------------------------
# 评测运行时（默认真实评测；虚拟/模拟已禁用）
# --------------------------------------------------------------------

# 仅支持 real（simulated 会直接失败）
ID009_EVAL_MODE=real

# financebench | six_domain
ID009_EVAL_FORMAT=financebench

# 可选；financebench 未填时默认 data/finqa/finqa_test_100.json
# ID009_EVAL_SAMPLES_FILE=/absolute/path/to/i-Core/x_models/id_x_009/data/finqa/finqa_test_100.json
ID009_EVAL_SAMPLES_FILE=

# 样本级瞬时失败重试；耗尽后默认跳过该样本继续任务（避免整任务 UPSTREAM_TIMEOUT）
ID009_EVAL_SAMPLE_MAX_RETRIES=2
ID009_EVAL_SAMPLE_RETRY_BACKOFF_SECONDS=2
ID009_EVAL_CONTINUE_ON_SAMPLE_ERROR=true

# --------------------------------------------------------------------
# 时区与每日全量评测（默认 Asia/Hong_Kong 00:00）
# --------------------------------------------------------------------
TZ=Asia/Hong_Kong
ID009_DAILY_EVAL_ENABLED=true
ID009_DAILY_EVAL_HOUR=0
ID009_DAILY_EVAL_MINUTE=0
ID009_DAILY_EVAL_TZ=Asia/Hong_Kong

# --------------------------------------------------------------------
# 运维脚本（可选）
# --------------------------------------------------------------------

# ID009_GRAPHQL_API=http://127.0.0.1:7001/b/id_x_009/graphql
